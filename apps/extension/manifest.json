{
  "manifest_version": 3,
  "name": "Classroom Manager – Tải bài nộp",
  "version": "1.2.1",
  "description": "Tải riêng từng bài nộp từ giao diện Google Classroom. Không thu thập thông tin đăng nhập.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "downloads", "alarms", "scripting"],
  "host_permissions": [
    "https://classroom.google.com/*",
    "https://drive.google.com/*",
    "https://huando200666.github.io/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Mở Classroom Manager" },
  "content_scripts": [
    {
      "matches": ["https://huando200666.github.io/classroom-manager/*"],
      "js": ["website.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://classroom.google.com/*", "https://drive.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
